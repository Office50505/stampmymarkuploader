# Line Art Uploader Shopify app credentials.
# Create a separate custom-distribution app for hfq8rc-8w.myshopify.com.
# Do not reuse credentials from another store's uploader.
SHOPIFY_API_KEY="your_shopify_client_id"
SHOPIFY_API_SECRET="your_shopify_client_secret"
SHOPIFY_APP_URL="https://hfq8rc-8w-lineart-uploader.up.railway.app"
SHOPIFY_SHOP_DOMAIN="hfq8rc-8w.myshopify.com"
SCOPES="read_products,read_orders,write_app_proxy"

# FAL runs GPT Image server-side. Keep this secret in Railway and never expose it to theme JavaScript.
FAL_KEY="your_fal_master_key"
FAL_LINE_ART_MODEL="openai/gpt-image-2.6/flare/edit"

# Optional: set the public storefront domain if this store uses one.
SHOP_CUSTOM_DOMAIN=""

# Line Art Uploader PostgreSQL database.
# For Railway local/dev access, use the public connection URL and add sslmode=require.
DATABASE_URL="postgresql://postgres:password@host.proxy.rlwy.net:41433/railway?sslmode=require"

# Bunny.net Storage Zone used for private originals and generated line art.
# Endpoint should not include the storage zone path. Example: https://sg.storage.bunnycdn.com
BUNNY_STORAGE_ENDPOINT="https://sg.storage.bunnycdn.com"
BUNNY_STORAGE_ZONE="your_storage_zone"
BUNNY_STORAGE_ACCESS_KEY="your_bunny_storage_password_or_access_key"

# Optional Bunny Pull Zone URL for previews if you create a private/tokenized pull zone later.
BUNNY_PULL_ZONE_URL=""

# Optional IP location lookup for upload records.
# Supported providers: "ipgeolocation" for city-level lookup, or "ipinfo" for country/network lookup.
# These keys are server-side only; never expose them in theme JavaScript.
IP_GEOLOCATION_PROVIDER="ipgeolocation"
IPGEOLOCATION_API_KEY="replace_with_ipgeolocation_api_key"
IPINFO_TOKEN=""

# Upload policy
UPLOAD_MAX_BYTES="26214400"
UPLOAD_RETENTION_DAYS="30"
UPLOAD_DELETE_EXPIRED_OBJECTS="false"
