generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UploadStatus {
  uploaded
  cart
  ordered
  abandoned
  expired
}

enum LineArtStatus {
  not_started
  processing
  completed
  failed
}

enum StampPreviewKind {
  box
  cup
  bag
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

model Upload {
  id                 String         @id @default(cuid())
  uploadId           String         @unique
  shop               String
  storageBucket      String
  storageKey         String         @unique
  storageUrl         String?
  originalFilename   String
  contentType        String
  fileSize           BigInt
  sourceSha256       String?
  uploadedAt         DateTime?
  productId          String?
  productHandle      String?
  productTitle       String?
  variantId          String?
  variantTitle       String?
  selectedSize       String?
  quantity           Int?
  textAbove          String?
  textBelow          String?
  designerNotes      String?
  lineArtStatus      LineArtStatus  @default(not_started)
  lineArtColor       String?
  lineArtModel       String?
  lineArtRequestId   String?
  lineArtStorageKey  String?
  lineArtStorageUrl  String?
  lineArtContentType String?
  lineArtFileSize    BigInt?
  lineArtGeneratedAt DateTime?
  lineArtError       String?
  lineArtCacheKey    String?
  sessionId          String?
  cartToken          String?
  customerId         String?
  ipAddress          String?
  ipCity             String?
  ipRegion           String?
  ipRegionCode       String?
  ipPostalCode       String?
  ipCountryCode      String?
  ipCountry          String?
  ipContinentCode    String?
  ipContinent        String?
  ipAsn              String?
  ipAsName           String?
  ipAsDomain         String?
  ipGeolocatedAt     DateTime?
  status             UploadStatus   @default(uploaded)
  orderId            String?
  orderName          String?
  orderLineItemId    String?
  orderedAt          DateTime?
  expiresAt          DateTime
  removedAt          DateTime?
  expiredAt          DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  stampPreviews      StampPreview[]

  @@index([shop, status, createdAt])
  @@index([shop, lineArtStatus, createdAt])
  @@index([shop, lineArtCacheKey, lineArtStatus, createdAt])
  @@index([shop, orderId])
  @@index([shop, sessionId])
  @@index([shop, ipCountryCode])
  @@index([expiresAt])
}

model StampPreview {
  id                       String           @id @default(cuid())
  uploadId                 String
  upload                   Upload           @relation(fields: [uploadId], references: [uploadId], onDelete: Cascade)
  kind                     StampPreviewKind
  status                   LineArtStatus    @default(not_started)
  model                    String?
  requestId                String?
  storageKey               String?
  storageUrl               String?
  contentType              String?
  fileSize                 BigInt?
  sourceLineArtGeneratedAt DateTime?
  generatedAt              DateTime?
  error                    String?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  @@unique([uploadId, kind])
  @@index([uploadId, status])
}

model WebhookDelivery {
  id          String   @id
  shop        String
  topic       String
  processedAt DateTime @default(now())

  @@index([shop, topic])
}

model CleanupRun {
  id            String    @id @default(cuid())
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  expiredCount  Int       @default(0)
  deletedCount  Int       @default(0)
  errorCount    Int       @default(0)
  retentionDays Int
  deleteObjects Boolean
  notes         String?
}
